{
  "manifest_version": 3,
  "name": "Gestor de Evidências Lite",
  "short_name": "Evidências Lite",
  "version": "0.2.0",
  "description": "Captura, anotação e documento de evidência de teste, direto do Chrome. Tudo local.",
  "minimum_chrome_version": "122",
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "action": {
    "default_title": "Gestor de Evidências Lite",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "config/config.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "desktopCapture",
    "notifications",
    "system.display",
    "unlimitedStorage"
  ],
  "commands": {
    "captura-aba": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "Capturar área da aba"
    },
    "captura-tela": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Capturar área de qualquer tela",
      "global": true
    }
  }
}
